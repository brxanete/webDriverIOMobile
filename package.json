{
  "name": "FirstMobile",
  "type": "module",
  "devDependencies": {
    "@testing-library/webdriverio": "^3.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^2.5.1",
    "appium-uiautomator2-driver": "^3.5.2",
    "tsx": "^4.10.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "npm run wdio -- --spec ./features/specs/login.spec.ts",
    "test:login": "npm run wdio -- --spec ./features/specs/login.spec.ts",
    "test:forms": "npm run wdio -- --spec ./features/specs/forms.spec.ts",
    "test:swipe": "npm run wdio -- --spec ./features/specs/swipe.spec.ts",
    "test:drag": "npm run wdio -- --spec ./features/specs/drag.spec.ts",
    "test:home": "npm run wdio -- --spec ./features/specs/home.spec.ts",
    "test:all": "npm run wdio",
    "test:smoke": "npm run wdio -- --mochaOpts.grep 'Validación visual'"
  }
}
