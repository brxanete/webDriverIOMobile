{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "default_agent": "build",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm *": "ask",
      "git push*": "ask",
      "git reset *": "ask",
      "git clean *": "ask"
    }
  }
}